# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
*/node_modules
/node_module.lnk

# testing
/coverage

# production
/build
/build-ios/WebViewExample/local_html
/build-electron
/dist

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local
.env

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# docs
engine/docs/*

# Ruffle SWF-preview runtime (28MB, mostly two .wasm blobs) — a fetched
# third-party dependency, not source. See BUILD.md for how to stage it.
/public/corelibs/ruffle

# ffmpeg.js (22MB) — upstream's video-export runtime. twip doesn't do video;
# kept on disk for the provisional editor but out of git history.
/public/corelibs/video

# Python bytecode from dev/twip_bridge.py
__pycache__/

# The compiler built to wasm, plus wasm-bindgen's generated glue. Build output of
# dev/build-wasm.sh, not source — vite.config.mjs's `virtual:twip-wasm` resolves to a
# stub when it is absent, so a checkout without it still builds.
/src/wasm-pkg/

# Baselines for dev/visual.mjs. Per-machine on purpose: browser text rendering
# differs between this box and a CI runner, so a committed PNG would fail there for
# reasons unrelated to the change under test. Bless locally, compare locally.
/dev/.visual
