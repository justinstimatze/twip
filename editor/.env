NODE_PATH='src/'
FAST_REFRESH=false
# CRA (react-scripts 2.0.5) preflight walks UP the directory tree and errors if it finds any
# eslint higher up than the project's node_modules (e.g. a stray ~/node_modules/eslint on the
# build machine). That eslint is unrelated to this frozen build; skip the check. Project-scoped.
SKIP_PREFLIGHT_CHECK=true
