{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "twip",
  "version": "0.1.0",
  "identifier": "com.twip.editor",
  "mainBinaryName": "twip",
  "build": {
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "twip",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Justin Stimatze <justin@justinstimatze.com>",
    "category": "GraphicsAndDesign",
    "shortDescription": "Draw on a timeline, export a .swf that Ruffle plays",
    "longDescription": "A modern Flash. Draw vector shapes on a timeline, tween them, and export a real .swf that Ruffle plays. Built on the Wick Editor by Wicklets LLC (GPLv3).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
