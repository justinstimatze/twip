{
  "name": "wick-editor",
  "version": "1.19.3",
  "author": "Wicklets LLC",
  "private": true,
  "homepage": "https://stickmanred.github.io/wick-editor",
  "main": "./public/electron.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/StickmanRed/wick-editor.git"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "@radix-ui/react-checkbox": "^1.3.10",
    "@radix-ui/react-label": "^2.1.14",
    "@radix-ui/react-popover": "^1.1.22",
    "@radix-ui/react-select": "^2.3.6",
    "@radix-ui/react-slider": "^1.4.6",
    "@radix-ui/react-slot": "^1.3.2",
    "@radix-ui/react-switch": "^1.3.6",
    "@radix-ui/react-tooltip": "^1.2.15",
    "audiobuffer-to-wav": "^1.0.0",
    "base64-arraybuffer": "^0.2.0",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.2.6",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "console-feed": "^3.1.10",
    "file-saver": "^2.0.0",
    "localforage": "^1.7.3",
    "lucide-react": "^1.26.0",
    "query-string": "^6.9.0",
    "react": "^19.2.8",
    "react-colorful": "^5.8.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.8",
    "react-hotkeys": "^2.0.0",
    "react-modal": "^3.16",
    "react-resizable-panels": "^4.12.2",
    "react-rnd": "^10.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tinycolor2": "^1.4.1",
    "underscore": "^1.13.7"
  },
  "build": {
    "appId": "com.wicklets.wickEditor",
    "productName": "Wick Editor",
    "icon": "public/icon.icns",
    "afterSign": "electron-builder-notarize",
    "copyright": "\u00a9 2016-2020 Wicklets LLC",
    "files": [
      "./build/**/*",
      "./public/electron.js"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "build/license_en.txt"
    },
    "mac": {
      "target": [
        "pkg",
        "dmg"
      ],
      "category": "public.app-category.entertainment",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "./entitlements.mac.plist",
      "entitlementsInherit": "./entitlements.mac.plist"
    },
    "dmg": {
      "icon": false
    },
    "pkg": {
      "license": "./build/license_en.txt"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Entertainment"
    },
    "win": {
      "icon": "build/icon.png"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build-engine": "pnpm --dir engine build && cp -a engine/dist/. public/corelibs/wick-engine/",
    "test-engine": "pnpm --dir engine test",
    "smoke": "node dev/smoke.mjs",
    "interact": "node dev/interact.mjs",
    "visual": "node dev/visual.mjs",
    "notices": "node dev/gen-notices.mjs",
    "notices:check": "node dev/gen-notices.mjs --check"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^8.2.0",
    "gulp": "^4.0.2",
    "gulp-babel": "^8.0.0",
    "gulp-concat": "^2.6.1",
    "gulp-header": "^2.0.9",
    "gulp-rename": "^2.0.0",
    "gulp-uglify": "^3.0.2",
    "playwright": "^1.62.0",
    "pngjs": "^7.0.0",
    "sass": "^1.83.0",
    "tailwindcss": "^4.3.3",
    "vite": "^6.0.7"
  },
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=20"
  }
}
